POSTGRES_DB=signaldock
POSTGRES_USER=signaldock
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Local demo only. Use a long random value outside the demo profile.
DEMO_API_KEY=sd_demo_local_key
APP_ADMIN_KEY=change-this-admin-key

# Delivery worker settings
DELIVERY_CONNECT_TIMEOUT=2s
DELIVERY_READ_TIMEOUT=4s
DELIVERY_BATCH_SIZE=20
# Milliseconds (consumed directly by Spring's scheduler annotation)
DELIVERY_POLL_DELAY=500
DELIVERY_LEASE_DURATION=30s
RETRY_BASE_DELAY=30s
RETRY_MAX_DELAY=1h
